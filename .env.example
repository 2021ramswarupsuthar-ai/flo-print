# Set these in Vercel -> Project -> Settings -> Environment Variables (never commit real values).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require   # Neon / Vercel Postgres connection string
SESSION_SECRET=change-me-to-a-long-random-string-32+chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password   # creates the first admin account when no users exist
# APP_ORIGIN=https://your-project.vercel.app   # optional: extra protection for cross-site requests
